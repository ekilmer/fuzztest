{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "displayName": "VCPKG Config",
      "description": "Configure with vcpkg",
      "binaryDir": "out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays/ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-overlays/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/clang_mold_toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux-mold",
        "VCPKG_HOST_TRIPLET": "x64-linux-mold"
      },
      "environment": {
        "VCPKG_ROOT": "${sourceParentDir}/vcpkg",
        "VCPKG_HOST_TRIPLET": "x64-linux-mold"
      }
    },
    {
      "name": "default-clang",
      "inherits": ["vcpkg"],
      "displayName": "Default Config",
      "generator": "Ninja",
      "description": "Default build using vcpkg",
      "binaryDir": "out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "FUZZTEST_BUILD_TESTING": "ON",
        "FUZZTEST_BUILD_FLATBUFFERS": "ON",
        "VCPKG_MANIFEST_FEATURES": "testing;flatbuffers"
      }
    },
    {
      "name": "fuzzing",
      "inherits": ["vcpkg"],
      "generator": "Ninja",
      "displayName": "Fuzzing Config",
      "description": "Build with fuzzing mode enabled using vcpkg",
      "binaryDir": "out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "FUZZTEST_BUILD_TESTING": "ON",
        "FUZZTEST_BUILD_FLATBUFFERS": "ON",
        "FUZZTEST_FUZZING_MODE": "ON",
        "VCPKG_MANIFEST_FEATURES": "testing;flatbuffers"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-clang",
      "configurePreset": "default-clang"
    },
    {
      "name": "fuzzing",
      "configurePreset": "fuzzing"
    }
  ],
  "testPresets": [
    {
      "name": "default-clang",
      "configurePreset": "default-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzzing",
      "configurePreset": "fuzzing",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
