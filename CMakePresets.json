{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "displayName": "VCPKG Config",
      "description": "Configure with vcpkg",
      "binaryDir": "out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays/ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-overlays/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/clang_mold_toolchain.cmake",
        "VCPKG_HOST_TRIPLET": "x64-linux-release"
      },
      "environment": {
        "VCPKG_ROOT": "${sourceParentDir}/vcpkg",
        "VCPKG_HOST_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "default-clang",
      "inherits": ["vcpkg"],
      "displayName": "Default Config",
      "generator": "Ninja",
      "description": "Default build using vcpkg",
      "binaryDir": "out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "FUZZTEST_BUILD_TESTING": "ON",
        "FUZZTEST_BUILD_FLATBUFFERS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-mold",
        "VCPKG_MANIFEST_FEATURES": "testing;flatbuffers"
      }
    },
    {
      "name": "fuzztest",
      "inherits": ["default-clang"],
      "generator": "Ninja",
      "displayName": "Fuzztest Config",
      "description": "Build with fuzzing mode (fuzztest)enabled using vcpkg",
      "binaryDir": "out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": null,
        "FUZZTEST_FUZZING_MODE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-fuzztest",
        "VCPKG_MANIFEST_FEATURES": "testing;flatbuffers"
      }
    },
    {
      "name": "libfuzzer",
      "inherits": ["fuzztest"],
      "cacheVariables": {
        "FUZZTEST_FUZZING_MODE": null,
        "FUZZTEST_COMPATIBILITY_MODE": "libfuzzer",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libfuzzer"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default-clang",
      "configurePreset": "default-clang"
    },
    {
      "name": "fuzztest",
      "configurePreset": "fuzztest"
    },
    {
      "name": "libfuzzer",
      "configurePreset": "libfuzzer"
    }
  ],
  "testPresets": [
    {
      "name": "default-clang",
      "configurePreset": "default-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzztest",
      "configurePreset": "fuzztest",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "libfuzzer",
      "configurePreset": "libfuzzer",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "default-clang",
      "displayName": "Default Workflow",
      "description": "Complete workflow: configure, build, and test with default Clang settings",
      "steps": [
        {
          "type": "configure",
          "name": "default-clang"
        },
        {
          "type": "build",
          "name": "default-clang"
        },
        {
          "type": "test",
          "name": "default-clang"
        }
      ]
    },
    {
      "name": "fuzztest",
      "displayName": "Fuzztest Workflow",
      "description": "Complete workflow: configure, build, and test with fuzztest enabled",
      "steps": [
        {
          "type": "configure",
          "name": "fuzztest"
        },
        {
          "type": "build",
          "name": "fuzztest"
        },
        {
          "type": "test",
          "name": "fuzztest"
        }
      ]
    },
    {
      "name": "libfuzzer",
      "displayName": "LibFuzzer Workflow",
      "description": "Complete workflow: configure, build, and test with libfuzzer compatibility",
      "steps": [
        {
          "type": "configure",
          "name": "libfuzzer"
        },
        {
          "type": "build",
          "name": "libfuzzer"
        },
        {
          "type": "test",
          "name": "libfuzzer"
        }
      ]
    }
  ]
}
